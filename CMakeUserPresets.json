{
  "version": 6,
  "include": [
    "CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "vcpkg-cache",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/cmake/QigaoVcpkgToolchain.cmake",
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;default,readwrite;nugettimeout,1800;nugetconfig,${sourceDir}/cmake/vcpkg-cache.nuget.config,read",
        "VCPKG_OVERLAY_PORTS": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/ports",
        "RE2C_ROOT": "$penv{RE2C_ROOT}",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "vcpkg-cache-windows",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{LOCALAPPDATA}/qigao/vcpkg-cache",
        "RE2C_ROOT": "$env{PKG_ROOT}/re2c/windows-x64"
      }
    },
    {
      "name": "vcpkg-cache-linux",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{HOME}/.cache/qigao/vcpkg-cache"
      }
    },
    {
      "name": "vcpkg-cache-ci",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{VCPKG_CACHE_REPOSITORY_ROOT}",
        "VCPKG_BINARY_SOURCES": "$penv{VCPKG_BINARY_SOURCES}",
        "VCPKG_OVERLAY_PORTS": "$penv{VCPKG_OVERLAY_PORTS}"
      }
    },
    {
      "name": "ci-win-release-user",
      "inherits": [
        "vcpkg-cache-ci",
        "win-release-user"
      ],
      "binaryDir": "${sourceDir}/build/ci-win-release-user",
      "environment": {
        "PKG_ROOT": "${sourceDir}/stage",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/ci-win-release-user/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{CHTTP_ROOT}/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/ci-win-release-user/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "$env{QIGAO_TARGET_TRIPLET}",
        "VCPKG_HOST_TRIPLET": "$env{QIGAO_TARGET_TRIPLET}",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}",
        "BUILD_TESTS": true,
        "ENABLE_TESTS": true,
        "ENABLE_SANITIZER_ADDRESS": false,
        "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/tools/pkgconf/pkgconf.exe"
      }
    },
    {
      "name": "ci-linux-release-user",
      "inherits": [
        "vcpkg-cache-ci",
        "linux-release-user"
      ],
      "binaryDir": "${sourceDir}/build/ci-linux-release-user",
      "environment": {
        "PKG_ROOT": "${sourceDir}/stage",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/ci-linux-release-user/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{CHTTP_ROOT}/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/ci-linux-release-user/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "$env{QIGAO_TARGET_TRIPLET}",
        "VCPKG_HOST_TRIPLET": "$env{QIGAO_TARGET_TRIPLET}",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}",
        "BUILD_TESTS": true,
        "ENABLE_TESTS": true,
        "ENABLE_SANITIZER_ADDRESS": false
      }
    },
    {
      "name": "win-toolchain",
      "hidden": true,
      "environment": {
        "PROJECT_ROOT": "$penv{PROJECT_ROOT}",
        "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
        "VCPKG_ROOT": "$penv{VCPKG_ROOT}",
        "USER_ROOT": "$penv{USERPROFILE}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      },
      "inherits": "vcpkg-cache-windows"
    },
    {
      "name": "win-paths",
      "hidden": true,
      "inherits": "win-toolchain",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "ON",
        "VCPKG_APPLOCAL_DEPS": "OFF",
        "VCPKG_HOST_TRIPLET": "x64-windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "linux-paths",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_MANIFEST_MODE": "ON",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      },
      "environment": {
        "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
        "VCPKG_ROOT": "$penv{VCPKG_ROOT}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "PROJECT_ROOT": "$penv{PROJECT_ROOT}"
      },
      "inherits": "vcpkg-cache-linux"
    },
    {
      "name": "android-win-environment",
      "hidden": true,
      "inherits": "win-toolchain",
      "environment": {
        "ANDROID_SDK_ROOT": "$env{USER_ROOT}/AppData/Local/Android/Sdk",
        "ANDROID_NDK_VERSION": "28.2.13676358",
        "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
      }
    },
    {
      "name": "android-win-user-paths",
      "hidden": true,
      "inherits": [
        "vcpkg-cache-windows",
        "android-win-paths",
        "ISWindows"
      ],
      "cacheVariables": {
        "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}"
      }
    },
    {
      "name": "win-dev-user",
      "inherits": [
        "base-win-dev-user",
        "win-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "CHTTP_ROOT": "$penv{CHTTP_ROOT}",
        "VCPKG_RUNTIME_BIN": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{CHTTP_ROOT}/bin${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbo_script/debug"
      }
    },
    {
      "name": "win-release-user",
      "inherits": [
        "base-win-release-user",
        "win-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "CHTTP_ROOT": "$penv{CHTTP_ROOT}",
        "VCPKG_RUNTIME_BIN": "$env{VCPKG_INSTALLED_DIR}/x64-windows/bin",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{CHTTP_ROOT}/bin${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbo_script/release"
      }
    },
    {
      "name": "linux-dev-user",
      "inherits": [
        "base-linux-dev-user",
        "linux-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "CHTTP_ROOT": "$penv{CHTTP_ROOT}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
        "RE2C_ROOT": "$penv{RE2C_ROOT}"
      },
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbo_script/debug"
      }
    },
    {
      "name": "linux-release-user",
      "inherits": [
        "release-linux-ninja",
        "linux-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "CHTTP_ROOT": "$penv{CHTTP_ROOT}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
        "RE2C_ROOT": "$penv{RE2C_ROOT}"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbo_script/release"
      }
    },
    {
      "name": "linux-sdk-package",
      "inherits": [
        "linux-release-user"
      ],
      "binaryDir": "${sourceDir}/build/linux-gcc-sdk-package",
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "OFF",
        "ENABLE_TESTS": "OFF",
        "BUILD_TESTS": "OFF",
        "BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "android-dependencies-debug",
      "hidden": true,
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/debug"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbo_script-android/debug"
      }
    },
    {
      "name": "android-dependencies-release",
      "hidden": true,
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/release",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/release"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbo_script-android/release"
      }
    },
    {
      "name": "android-arm64-v8a-debug-win",
      "inherits": [
        "android-arm64-v8a-debug",
        "android-dependencies-debug",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-arm64-v8a-release-win",
      "inherits": [
        "android-arm64-v8a-release",
        "android-dependencies-release",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86_64-debug-win",
      "inherits": [
        "android-x86_64-debug",
        "android-dependencies-debug",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86_64-release-win",
      "inherits": [
        "android-x86_64-release",
        "android-dependencies-release",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86-debug-win",
      "inherits": [
        "android-x86-debug",
        "android-dependencies-debug",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86-release-win",
      "inherits": [
        "android-x86-release",
        "android-dependencies-release",
        "android-win-user-paths",
        "android-win-environment"
      ]
    }
  ],
  "buildPresets": [
