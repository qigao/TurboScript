/**
 * @file test_data_bind_class_wrapping.tbs
 * @brief 演示如何将 DataBind 返回的 Plain Object 包装成 TurboScript Class
 * 
 * DataBind 返回的是纯数据对象（Plain Object），不包含方法。
 * 本示例展示三种常用模式，将 Plain Object 包装为具有行为的 Class Instance。
 */

import("data_bind");

// ============================================================================
// Schema 定义
// ============================================================================

var schema = `
message User {
    string name;
    int age;
    string email;
    bool premium;
}

message Order {
    int id;
    string symbol;
    double price;
    int quantity;
}
`;

var codec = data_bind.create_from_text(schema);

// ============================================================================
// 模式 A: 构造函数包装（Constructor Wrapping）
// ============================================================================

print("=== Pattern A: Constructor Wrapping ===\n");

class UserA {
    name = "";
    age = 0;
    email = "";
    premium = false;
    
    // 构造函数接受 Plain Object 并复制字段
    constructor(plain_obj) {
        this.name = plain_obj.name;
        this.age = plain_obj.age;
        this.email = plain_obj.email;
        this.premium = plain_obj.premium;
    }
    
    greet() {
        return "Hello, " + this.name + "!";
    }
    
    is_adult() {
        return this.age >= 18;
    }
    
    get_account_type() {
        return this.premium ? "Premium" : "Free";
    }
    
    send_email(subject, body) {
        print("  [EMAIL] To: " + this.email);
        print("  [EMAIL] Subject: " + subject);
        print("  [EMAIL] Body: " + body);
    }
}

// 使用模式 A
var json_a = '{"name":"Alice","age":30,"email":"alice@example.com","premium":true}';
var plain_a = data_bind.parse_json(codec, "User", json_a);
var user_a = new UserA(plain_a);

print(user_a.greet());
print("Account type: " + user_a.get_account_type());
print("Is adult: " + user_a.is_adult());
user_a.send_email("Welcome", "Thanks for joining!");
print("");

// ============================================================================
// 模式 B: 工厂函数（Factory Function）
// ============================================================================

print("=== Pattern B: Factory Function ===\n");

class UserB {
    name = "";
    age = 0;
    email = "";
    premium = false;
    
    greet() {
        return "Hello, " + this.name + "!";
    }
    
    is_adult() {
        return this.age >= 18;
    }
    
    get_account_type() {
        return this.premium ? "Premium" : "Free";
    }
}

// 工厂函数负责解析 + 包装
function create_user_from_json(codec, json_text) {
    var plain = data_bind.parse_json(codec, "User", json_text);
    var user = new UserB();
    user.name = plain.name;
    user.age = plain.age;
    user.email = plain.email;
    user.premium = plain.premium;
    return user;
}

// 使用模式 B
var json_b = '{"name":"Bob","age":25,"email":"bob@example.com","premium":false}';
var user_b = create_user_from_json(codec, json_b);

print(user_b.greet());
print("Account type: " + user_b.get_account_type());
print("Is adult: " + user_b.is_adult());
print("");

// ============================================================================
// 模式 C: 静态工厂方法（Static Factory Method）
// ============================================================================

print("=== Pattern C: Static Factory Method ===\n");

class UserC {
    name = "";
    age = 0;
    email = "";
    premium = false;
    
    // 静态工厂方法：从 JSON 创建
    static from_json(codec, json_text) {
        var plain = data_bind.parse_json(codec, "User", json_text);
        var user = new UserC();
        user.name = plain.name;
        user.age = plain.age;
        user.email = plain.email;
        user.premium = plain.premium;
        return user;
    }
    
    // 静态工厂方法：从 Plain Object 创建
    static from_plain(plain) {
        var user = new UserC();
        user.name = plain.name;
        user.age = plain.age;
        user.email = plain.email;
        user.premium = plain.premium;
        return user;
    }
    
    greet() {
        return "Hello, " + this.name + "!";
    }
    
    is_adult() {
        return this.age >= 18;
    }
    
    get_account_type() {
        return this.premium ? "Premium" : "Free";
    }
}

// 使用模式 C：直接从 JSON 创建
var json_c1 = '{"name":"Charlie","age":35,"email":"charlie@example.com","premium":true}';
var user_c1 = UserC.from_json(codec, json_c1);

print(user_c1.greet());
print("Account type: " + user_c1.get_account_type());
print("");

// 使用模式 C：从 Plain Object 创建
var json_c2 = '{"name":"Diana","age":28,"email":"diana@example.com","premium":false}';
var plain_c2 = data_bind.parse_json(codec, "User", json_c2);
var user_c2 = UserC.from_plain(plain_c2);

print(user_c2.greet());
print("Account type: " + user_c2.get_account_type());
print("");

// ============================================================================
// 批量处理示例
// ============================================================================

print("=== Batch Processing Example ===\n");

class Order {
    id = 0;
    symbol = "";
    price = 0.0;
    quantity = 0;
    
    static from_json(codec, json_text) {
        var plain = data_bind.parse_json(codec, "Order", json_text);
        var order = new Order();
        order.id = plain.id;
        order.symbol = plain.symbol;
        order.price = plain.price;
        order.quantity = plain.quantity;
        return order;
    }
    
    total_value() {
        return this.price * this.quantity;
    }
    
    to_string() {
        return "Order #" + this.id + ": " + this.quantity + " x " + 
               this.symbol + " @ $" + this.price + " = $" + this.total_value();
    }
}

// 批量导入订单
function import_orders(codec, json_array_text) {
    var plain_list = data_bind.parse_json_all(codec, "Order", json_array_text);
    var orders = [];
    
    for (var i = 0; i < len(plain_list); i++) {
        var plain = plain_list[i];
        var order = new Order();
        order.id = plain.id;
        order.symbol = plain.symbol;
        order.price = plain.price;
        order.quantity = plain.quantity;
        orders.push(order);
    }
    
    return orders;
}

// 测试批量导入
var orders_json = '[
    {"id":1001,"symbol":"AAPL","price":150.50,"quantity":100},
    {"id":1002,"symbol":"GOOGL","price":2800.00,"quantity":50},
    {"id":1003,"symbol":"MSFT","price":300.25,"quantity":200}
]';

var orders = import_orders(codec, orders_json);

print("Imported " + len(orders) + " orders:");
for (var i = 0; i < len(orders); i++) {
    print("  " + orders[i].to_string());
}

var total = 0;
for (var i = 0; i < len(orders); i++) {
    total += orders[i].total_value();
}
print("Total portfolio value: $" + total);
print("");

// ============================================================================
// 对比：Plain Object vs Class Instance
// ============================================================================

print("=== Plain Object vs Class Instance ===\n");

var json_plain = '{"name":"Eve","age":22,"email":"eve@example.com","premium":false}';
var plain = data_bind.parse_json(codec, "User", json_plain);
var instance = UserC.from_json(codec, json_plain);

// Plain Object: 只能访问字段
print("Plain Object:");
print("  name: " + plain.name);
print("  age: " + plain.age);
print("  Type: " + typeof(plain));
// print("  greet(): " + plain.greet());  // ❌ 错误！Plain Object 没有方法

print("");

// Class Instance: 可以访问字段和方法
print("Class Instance:");
print("  name: " + instance.name);
print("  age: " + instance.age);
print("  greet(): " + instance.greet());  // ✅ 可以调用方法
print("  is_adult(): " + instance.is_adult());
print("  Type: " + typeof(instance));

print("");
print("=== Test Complete ===");
