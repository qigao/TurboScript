/**
 * @file data_bind_trading_system.tbs
 * @brief 完整的交易系统示例：展示 DataBind + Class 的实际应用
 * 
 * 本示例演示：
 * 1. Repository 模式
 * 2. 领域模型（DDD）
 * 3. 状态机
 * 4. 批量处理
 * 5. 性能优化
 */

import("data_bind");

// ============================================================================
// Schema 定义
// ============================================================================

var schema = `
message Account {
    int id;
    string username;
    double balance;
    string status;  // ACTIVE, SUSPENDED, CLOSED
}

message Order {
    int id;
    int account_id;
    string symbol;
    string side;    // BUY, SELL
    double price;
    int quantity;
    string status;  // PENDING, FILLED, CANCELLED, REJECTED
    int64 created_at;
    int64 filled_at;
}

message Trade {
    int id;
    int order_id;
    string symbol;
    double price;
    int quantity;
    int64 timestamp;
}

message MarketData {
    string symbol;
    double last_price;
    double bid;
    double ask;
    int volume;
    int64 timestamp;
}
`;

var codec = data_bind.create_from_text(schema);

// ============================================================================
// 领域模型：Account
// ============================================================================

class Account {
    id = 0;
    username = "";
    balance = 0.0;
    status = "ACTIVE";
    
    static from_json(json_text) {
        var plain = data_bind.parse_json(codec, "Account", json_text);
        return Account.from_plain(plain);
    }
    
    static from_plain(plain) {
        var acc = new Account();
        acc.id = plain.id;
        acc.username = plain.username;
        acc.balance = plain.balance;
        acc.status = plain.status;
        return acc;
    }
    
    is_active() {
        return this.status == "ACTIVE";
    }
    
    can_trade() {
        return this.is_active() && this.balance > 0;
    }
    
    deduct(amount) {
        if (amount > this.balance) {
            throw "Insufficient balance";
        }
        this.balance -= amount;
    }
    
    credit(amount) {
        this.balance += amount;
    }
    
    suspend() {
        if (this.status == "CLOSED") {
            throw "Cannot suspend closed account";
        }
        this.status = "SUSPENDED";
    }
    
    to_plain() {
        return {
            id: this.id,
            username: this.username,
            balance: this.balance,
            status: this.status
        };
    }
}

// ============================================================================
// 领域模型：Order (状态机)
// ============================================================================

class Order {
    id = 0;
    account_id = 0;
    symbol = "";
    side = "BUY";
    price = 0.0;
    quantity = 0;
    status = "PENDING";
    created_at = 0;
    filled_at = 0;
    
    static from_json(json_text) {
        var plain = data_bind.parse_json(codec, "Order", json_text);
        return Order.from_plain(plain);
    }
    
    static from_plain(plain) {
        var order = new Order();
        order.id = plain.id;
        order.account_id = plain.account_id;
        order.symbol = plain.symbol;
        order.side = plain.side;
        order.price = plain.price;
        order.quantity = plain.quantity;
        order.status = plain.status;
        order.created_at = plain.created_at;
        order.filled_at = plain.filled_at;
        return order;
    }
    
    total_value() {
        return this.price * this.quantity;
    }
    
    can_cancel() {
        return this.status == "PENDING";
    }
    
    can_fill() {
        return this.status == "PENDING";
    }
    
    cancel() {
        if (!this.can_cancel()) {
            throw "Cannot cancel order in status: " + this.status;
        }
        this.status = "CANCELLED";
        print("  [ORDER] Cancelled order #" + this.id);
    }
    
    fill(filled_at) {
        if (!this.can_fill()) {
            throw "Cannot fill order in status: " + this.status;
        }
        this.status = "FILLED";
        this.filled_at = filled_at;
        print("  [ORDER] Filled order #" + this.id + " @ $" + this.price);
    }
    
    reject(reason) {
        if (this.status != "PENDING") {
            throw "Cannot reject order in status: " + this.status;
        }
        this.status = "REJECTED";
        print("  [ORDER] Rejected order #" + this.id + ": " + reason);
    }
    
    to_plain() {
        return {
            id: this.id,
            account_id: this.account_id,
            symbol: this.symbol,
            side: this.side,
            price: this.price,
            quantity: this.quantity,
            status: this.status,
            created_at: this.created_at,
            filled_at: this.filled_at
        };
    }
}

// ============================================================================
// 领域模型：Trade
// ============================================================================

class Trade {
    id = 0;
    order_id = 0;
    symbol = "";
    price = 0.0;
    quantity = 0;
    timestamp = 0;
    
    static from_plain(plain) {
        var trade = new Trade();
        trade.id = plain.id;
        trade.order_id = plain.order_id;
        trade.symbol = plain.symbol;
        trade.price = plain.price;
        trade.quantity = plain.quantity;
        trade.timestamp = plain.timestamp;
        return trade;
    }
    
    total_value() {
        return this.price * this.quantity;
    }
}

// ============================================================================
// Repository: AccountRepository
// ============================================================================

class AccountRepository {
    accounts = map{};  // id -> Account
    
    save(account) {
        this.accounts[account.id] = account;
    }
    
    find_by_id(id) {
        if (this.accounts[id] == null) {
            throw "Account not found: " + id;
        }
        return this.accounts[id];
    }
    
    load_from_json(json_text) {
        var plain = data_bind.parse_json(codec, "Account", json_text);
        var account = Account.from_plain(plain);
        this.save(account);
        return account;
    }
    
    load_batch_from_json(json_array_text) {
        var plains = data_bind.parse_json_all(codec, "Account", json_array_text);
        var accounts = [];
        for (var i = 0; i < len(plains); i++) {
            var account = Account.from_plain(plains[i]);
            this.save(account);
            accounts.push(account);
        }
        return accounts;
    }
}

// ============================================================================
// Repository: OrderRepository
// ============================================================================

class OrderRepository {
    orders = map{};  // id -> Order
    next_id = 1;
    
    save(order) {
        this.orders[order.id] = order;
    }
    
    find_by_id(id) {
        if (this.orders[id] == null) {
            throw "Order not found: " + id;
        }
        return this.orders[id];
    }
    
    find_pending_orders() {
        var pending = [];
        // 注意：这里简化了，实际应使用哈希表迭代
        for (var id in this.orders) {
            var order = this.orders[id];
            if (order.status == "PENDING") {
                pending.push(order);
            }
        }
        return pending;
    }
    
    create(account_id, symbol, side, price, quantity) {
        var order = new Order();
        order.id = this.next_id;
        this.next_id += 1;
        order.account_id = account_id;
        order.symbol = symbol;
        order.side = side;
        order.price = price;
        order.quantity = quantity;
        order.status = "PENDING";
        order.created_at = now();
        
        this.save(order);
        return order;
    }
}

// ============================================================================
// 交易引擎
// ============================================================================

class TradingEngine {
    account_repo = null;
    order_repo = null;
    trades = [];
    next_trade_id = 1;
    
    constructor(account_repo, order_repo) {
        this.account_repo = account_repo;
        this.order_repo = order_repo;
    }
    
    place_order(account_id, symbol, side, price, quantity) {
        print("\n[ENGINE] Placing order...");
        
        // 1. 验证账户
        var account = this.account_repo.find_by_id(account_id);
        if (!account.can_trade()) {
            throw "Account cannot trade: " + account.status;
        }
        
        // 2. 检查余额（买单）
        if (side == "BUY") {
            var required = price * quantity;
            if (account.balance < required) {
                throw "Insufficient balance: " + account.balance + " < " + required;
            }
        }
        
        // 3. 创建订单
        var order = this.order_repo.create(account_id, symbol, side, price, quantity);
        print("  [ENGINE] Created order #" + order.id);
        
        return order;
    }
    
    match_orders(market_price) {
        print("\n[ENGINE] Matching orders at market price: $" + market_price);
        
        var pending = this.order_repo.find_pending_orders();
        var matched_count = 0;
        
        for (var i = 0; i < len(pending); i++) {
            var order = pending[i];
            
            // 简化的撮合逻辑
            var should_fill = false;
            if (order.side == "BUY" && market_price <= order.price) {
                should_fill = true;
            } else if (order.side == "SELL" && market_price >= order.price) {
                should_fill = true;
            }
            
            if (should_fill) {
                this.fill_order(order, market_price);
                matched_count += 1;
            }
        }
        
        print("  [ENGINE] Matched " + matched_count + " orders");
    }
    
    fill_order(order, fill_price) {
        // 1. 更新订单状态
        order.fill(now());
        
        // 2. 创建成交记录
        var trade = new Trade();
        trade.id = this.next_trade_id;
        this.next_trade_id += 1;
        trade.order_id = order.id;
        trade.symbol = order.symbol;
        trade.price = fill_price;
        trade.quantity = order.quantity;
        trade.timestamp = now();
        this.trades.push(trade);
        
        // 3. 更新账户余额
        var account = this.account_repo.find_by_id(order.account_id);
        if (order.side == "BUY") {
            var cost = fill_price * order.quantity;
            account.deduct(cost);
            print("  [ENGINE] Debited $" + cost + " from account #" + account.id);
        } else {
            var revenue = fill_price * order.quantity;
            account.credit(revenue);
            print("  [ENGINE] Credited $" + revenue + " to account #" + account.id);
        }
    }
    
    cancel_order(order_id) {
        var order = this.order_repo.find_by_id(order_id);
        order.cancel();
    }
    
    get_trade_summary() {
        var total_volume = 0;
        var total_value = 0.0;
        
        for (var i = 0; i < len(this.trades); i++) {
            var trade = this.trades[i];
            total_volume += trade.quantity;
            total_value += trade.total_value();
        }
        
        return {
            trade_count: len(this.trades),
            total_volume: total_volume,
            total_value: total_value
        };
    }
}

// ============================================================================
// 测试场景
// ============================================================================

print("=== Trading System Demo ===\n");

// 1. 初始化 Repositories
var account_repo = new AccountRepository();
var order_repo = new OrderRepository();

// 2. 加载账户（批量）
print("[SETUP] Loading accounts...");
var accounts_json = '[
    {"id":1,"username":"alice","balance":10000.0,"status":"ACTIVE"},
    {"id":2,"username":"bob","balance":5000.0,"status":"ACTIVE"},
    {"id":3,"username":"charlie","balance":2000.0,"status":"SUSPENDED"}
]';
account_repo.load_batch_from_json(accounts_json);
print("  Loaded " + len(account_repo.accounts) + " accounts");

// 3. 创建交易引擎
var engine = new TradingEngine(account_repo, order_repo);

// 4. 下单
try {
    engine.place_order(1, "AAPL", "BUY", 150.0, 10);   // Alice 买入
    engine.place_order(2, "AAPL", "BUY", 148.0, 20);   // Bob 买入
    engine.place_order(1, "GOOGL", "SELL", 2800.0, 5); // Alice 卖出
} catch (err) {
    print("  [ERROR] " + err);
}

// 5. 测试无效订单
print("\n[TEST] Attempting invalid order...");
try {
    engine.place_order(3, "MSFT", "BUY", 300.0, 10);  // Charlie 账户被暂停
} catch (err) {
    print("  [ERROR] " + err + " (Expected)");
}

// 6. 市场撮合
engine.match_orders(149.0);  // 市场价 $149，Alice 的买单会成交

// 7. 取消订单
print("\n[TEST] Cancelling order...");
engine.cancel_order(2);  // 取消 Bob 的订单

// 8. 查看账户状态
print("\n[SUMMARY] Account Balances:");
var alice = account_repo.find_by_id(1);
var bob = account_repo.find_by_id(2);
print("  Alice: $" + alice.balance + " (started with $10000)");
print("  Bob:   $" + bob.balance + " (started with $5000)");

// 9. 交易统计
print("\n[SUMMARY] Trading Statistics:");
var summary = engine.get_trade_summary();
print("  Total Trades: " + summary.trade_count);
print("  Total Volume: " + summary.total_volume + " shares");
print("  Total Value:  $" + summary.total_value);

// 10. 导出订单到 JSON（演示序列化）
print("\n[EXPORT] Exporting orders to JSON...");
var all_orders = [];
for (var i = 1; i < order_repo.next_id; i++) {
    try {
        var order = order_repo.find_by_id(i);
        all_orders.push(order.to_plain());
    } catch (err) {
        // 订单可能不存在
    }
}

// 使用 DataBind 将 Plain Object 序列化为 JSON
for (var i = 0; i < len(all_orders); i++) {
    var json = data_bind.to_json(codec, all_orders[i]);
    print("  Order #" + (i+1) + ": " + json);
}

print("\n=== Demo Complete ===");

// ============================================================================
// 性能测试：Plain Object vs Class Instance
// ============================================================================

print("\n=== Performance Test ===\n");

// 生成测试数据
var test_orders_json = '[';
for (var i = 0; i < 1000; i++) {
    if (i > 0) test_orders_json += ',';
    test_orders_json += '{"id":' + i + ',"account_id":1,"symbol":"TEST","side":"BUY","price":100.0,"quantity":10,"status":"PENDING","created_at":0,"filled_at":0}';
}
test_orders_json += ']';

// 测试 1：Plain Object（无包装）
var start1 = now();
var plain_orders = data_bind.parse_json_all(codec, "Order", test_orders_json);
var total1 = 0;
for (var i = 0; i < len(plain_orders); i++) {
    total1 += plain_orders[i].quantity;  // 直接访问字段
}
var elapsed1 = now() - start1;
print("Plain Object (no wrapping): " + elapsed1 + " ms, total=" + total1);

// 测试 2：Class Instance（包装）
var start2 = now();
var plain_orders2 = data_bind.parse_json_all(codec, "Order", test_orders_json);
var class_orders = [];
for (var i = 0; i < len(plain_orders2); i++) {
    class_orders.push(Order.from_plain(plain_orders2[i]));
}
var total2 = 0;
for (var i = 0; i < len(class_orders); i++) {
    total2 += class_orders[i].quantity;  // 通过类访问
}
var elapsed2 = now() - start2;
print("Class Instance (with wrapping): " + elapsed2 + " ms, total=" + total2);

var overhead = (elapsed2 - elapsed1) / elapsed1 * 100;
print("\nWrapping overhead: " + overhead + "%");
print("Recommendation: Use Plain Object for data-heavy processing");

data_bind.free(codec);
