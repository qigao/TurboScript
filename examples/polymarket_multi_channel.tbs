// One-message Polymarket smoke test. For repeated receives, use
// polymarket_multi_channel_long_run.tbs.
// Refresh market token IDs from:
// https://gamma-api.polymarket.com/markets?active=true&closed=false&limit=3
import("./polymarket_patterns.tbs");

var market_task = task.spawn(() => {
    var metrics = MetricsObserver();
    var bus = EventBus();
    bus.attach(PreviewObserver(160));
    bus.attach(metrics);
    var command = MarketSubscriptionCommand(market_subscription, bus, metrics);
    return command.execute();
});

var sports_task = task.spawn(() => {
    var metrics = MetricsObserver();
    var bus = EventBus();
    bus.attach(PreviewObserver(160));
    bus.attach(metrics);
    var command = SportsSubscriptionCommand(bus, metrics);
    return command.execute();
});

var report_task = task.spawn(() => {
    try {
        var market = task.join(market_task);
        var sports = task.join(sports_task);
        print("processed market events=" + market.events
              + " bytes=" + market.bytes
              + " payload=" + market.payload_type);
        print("processed sports events=" + sports.events
              + " bytes=" + sports.bytes
              + " payload=" + sports.payload_type);
        return market.bytes + sports.bytes;
    } catch (error) {
        print("Polymarket command failed: " + error);
        throw error;
    }
});
