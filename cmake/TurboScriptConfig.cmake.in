@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)
find_dependency(Salts CONFIG REQUIRED PATHS "$ENV{SALTS_ROOT}" NO_CMAKE_FIND_ROOT_PATH)
find_dependency(SaltsUtils CONFIG REQUIRED PATHS "$ENV{SALTS_UTILS_ROOT}" NO_CMAKE_FIND_ROOT_PATH)

set_and_check(TurboScript_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(TurboScript_LIBRARY_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

include("${CMAKE_CURRENT_LIST_DIR}/TurboScriptTargets.cmake")

check_required_components(TurboScript)
