{
  "version": 6,
  "include": [
    "../../../CMakeUserPresets.json"
  ],
  "configurePresets": [
    {
      "name": "ci-installed-sdk-linux-user",
      "inherits": "ci-linux-sdk-user",
      "binaryDir": "${sourceDir}/../../../build/installed-sdk-linux",
      "environment": {
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "CHTTP_ROOT": "$penv{CHTTP_ROOT}",
        "TURBODB_ROOT": "$penv{TURBODB_ROOT}",
        "TURBOSCRIPT_ROOT": "$penv{TURBOSCRIPT_ROOT}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../../vcpkg_installed",
        "LD_LIBRARY_PATH": "$env{TURBOSCRIPT_ROOT}/lib${pathListSep}$env{TURBODB_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
        "DYLD_LIBRARY_PATH": "$env{TURBOSCRIPT_ROOT}/lib${pathListSep}$env{TURBODB_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$penv{DYLD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "VCPKG_MANIFEST_DIR": "${sourceDir}/../../.."
      }
    },
    {
      "name": "ci-installed-sdk-macos-user",
      "inherits": "ci-macos-sdk-user",
      "binaryDir": "${sourceDir}/../../../build/installed-sdk-macos",
      "environment": {
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "CHTTP_ROOT": "$penv{CHTTP_ROOT}",
        "TURBODB_ROOT": "$penv{TURBODB_ROOT}",
        "TURBOSCRIPT_ROOT": "$penv{TURBOSCRIPT_ROOT}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../../vcpkg_installed",
        "LD_LIBRARY_PATH": "$env{TURBOSCRIPT_ROOT}/lib${pathListSep}$env{TURBODB_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
        "DYLD_LIBRARY_PATH": "$env{TURBOSCRIPT_ROOT}/lib${pathListSep}$env{TURBODB_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$penv{DYLD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "VCPKG_MANIFEST_DIR": "${sourceDir}/../../.."
      }
    },
    {
      "name": "ci-installed-sdk-android-user",
      "inherits": "ci-android-sdk-user",
      "binaryDir": "${sourceDir}/../../../build/installed-sdk-android",
      "environment": {
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "CHTTP_ROOT": "$penv{CHTTP_ROOT}",
        "TURBODB_ROOT": "$penv{TURBODB_ROOT}",
        "TURBOSCRIPT_ROOT": "$penv{TURBOSCRIPT_ROOT}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../../vcpkg_installed",
        "LD_LIBRARY_PATH": "$env{TURBOSCRIPT_ROOT}/lib${pathListSep}$env{TURBODB_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
        "DYLD_LIBRARY_PATH": "$env{TURBOSCRIPT_ROOT}/lib${pathListSep}$env{TURBODB_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$penv{DYLD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "VCPKG_MANIFEST_DIR": "${sourceDir}/../../.."
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ci-installed-sdk-linux-user",
      "configurePreset": "ci-installed-sdk-linux-user"
    },
    {
      "name": "ci-installed-sdk-macos-user",
      "configurePreset": "ci-installed-sdk-macos-user"
    },
    {
      "name": "ci-installed-sdk-android-user",
      "configurePreset": "ci-installed-sdk-android-user"
    }
  ],
  "testPresets": [
    {
      "name": "ci-installed-sdk-linux-user",
      "configurePreset": "ci-installed-sdk-linux-user",
      "inherits": "base-test"
    },
    {
      "name": "ci-installed-sdk-macos-user",
      "configurePreset": "ci-installed-sdk-macos-user",
      "inherits": "base-test"
    }
  ]
}
