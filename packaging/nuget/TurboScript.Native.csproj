<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>TurboScript.Native</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">3.0.5</PackageVersion>
    <Authors>qigao</Authors>
    <Description>TurboScript MIR interpreter/JIT and native module SDK for Linux x64, macOS arm64 and Android arm64-v8a. Bundled native modules are included; CLI is excluded.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/qigao/TurboScript</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="$(PackageRoot)/sdk/**/*" Pack="true" PackagePath="sdk/" />
  </ItemGroup>
</Project>
