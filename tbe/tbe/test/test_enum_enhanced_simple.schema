schema EnhancedTestSimple [id(1), version(1), byte_order(little)];

enum UserRole <uint8> {
    Guest = 0;
    User = 1;
    Moderator = 2;
    Admin = 3;
}

enum Status <uint16> {
    Inactive = 0;
    Active = 1;
    Suspended = 2;
    Deleted = 3;
}

message UserProfile {
    required uint32 id;
    optional UserRole role default User;
    required Status status;
}